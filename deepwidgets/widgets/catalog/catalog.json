{
 "id": "shadcn-widgets@1",
 "root": "Card",
 "schema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
   "Card": {
    "$ref": "#/$defs/Card"
   },
   "Row": {
    "$ref": "#/$defs/Row"
   },
   "List": {
    "$ref": "#/$defs/List"
   },
   "CardHeader": {
    "$ref": "#/$defs/CardHeader"
   },
   "TextContent": {
    "$ref": "#/$defs/TextContent"
   },
   "Stat": {
    "$ref": "#/$defs/Stat"
   },
   "Button": {
    "$ref": "#/$defs/Button"
   },
   "Input": {
    "$ref": "#/$defs/Input"
   },
   "Checkbox": {
    "$ref": "#/$defs/Checkbox"
   },
   "Badge": {
    "$ref": "#/$defs/Badge"
   },
   "Progress": {
    "$ref": "#/$defs/Progress"
   },
   "Alert": {
    "$ref": "#/$defs/Alert"
   },
   "Separator": {
    "$ref": "#/$defs/Separator"
   },
   "Table": {
    "$ref": "#/$defs/Table"
   },
   "Col": {
    "$ref": "#/$defs/Col"
   },
   "Empty": {
    "$ref": "#/$defs/Empty"
   },
   "BarChart": {
    "$ref": "#/$defs/BarChart"
   },
   "LineChart": {
    "$ref": "#/$defs/LineChart"
   },
   "Series": {
    "$ref": "#/$defs/Series"
   }
  },
  "required": [
   "Card",
   "Row",
   "List",
   "CardHeader",
   "TextContent",
   "Stat",
   "Button",
   "Input",
   "Checkbox",
   "Badge",
   "Progress",
   "Alert",
   "Separator",
   "Table",
   "Col",
   "Empty",
   "BarChart",
   "LineChart",
   "Series"
  ],
  "additionalProperties": false,
  "$defs": {
   "Card": {
    "type": "object",
    "properties": {
     "children": {
      "type": "array",
      "items": {
       "anyOf": [
        {
         "$ref": "#/$defs/CardHeader"
        },
        {
         "$ref": "#/$defs/TextContent"
        },
        {
         "$ref": "#/$defs/Stat"
        },
        {
         "$ref": "#/$defs/Button"
        },
        {
         "$ref": "#/$defs/Input"
        },
        {
         "$ref": "#/$defs/Checkbox"
        },
        {
         "$ref": "#/$defs/Badge"
        },
        {
         "$ref": "#/$defs/Progress"
        },
        {
         "$ref": "#/$defs/Alert"
        },
        {
         "$ref": "#/$defs/Separator"
        },
        {
         "$ref": "#/$defs/Table"
        },
        {
         "$ref": "#/$defs/Empty"
        },
        {
         "$ref": "#/$defs/BarChart"
        },
        {
         "$ref": "#/$defs/LineChart"
        },
        {
         "$ref": "#/$defs/Row"
        },
        {
         "$ref": "#/$defs/List"
        }
       ]
      }
     }
    },
    "required": [
     "children"
    ],
    "additionalProperties": false,
    "description": "The widget body. Children stack top to bottom."
   },
   "CardHeader": {
    "type": "object",
    "properties": {
     "title": {
      "type": "string"
     },
     "description": {
      "type": "string"
     }
    },
    "required": [
     "title"
    ],
    "additionalProperties": false,
    "description": "Title/description header block for a Card."
   },
   "TextContent": {
    "type": "object",
    "properties": {
     "text": {
      "type": "string"
     },
     "size": {
      "type": "string",
      "enum": [
       "small",
       "default",
       "large",
       "small-heavy",
       "large-heavy"
      ]
     }
    },
    "required": [
     "text"
    ],
    "additionalProperties": false,
    "description": "Text block with optional size. size: \"small\" | \"default\" | \"large\" | \"small-heavy\" | \"large-heavy\"."
   },
   "Stat": {
    "type": "object",
    "properties": {
     "label": {
      "type": "string"
     },
     "value": {
      "type": [
       "string",
       "number"
      ]
     },
     "note": {
      "type": "string"
     }
    },
    "required": [
     "label",
     "value"
    ],
    "additionalProperties": false,
    "description": "Key number: small label, large value, optional note."
   },
   "Button": {
    "type": "object",
    "properties": {
     "label": {
      "type": "string"
     },
     "action": {
      "$ref": "#/$defs/ActionExpression"
     },
     "variant": {
      "type": "string",
      "enum": [
       "default",
       "secondary",
       "outline",
       "ghost",
       "destructive"
      ]
     },
     "size": {
      "type": "string",
      "enum": [
       "default",
       "sm"
      ]
     }
    },
    "required": [
     "label"
    ],
    "additionalProperties": false,
    "description": "Button that runs an action. variant: \"default\" | \"secondary\" | \"outline\" | \"ghost\" | \"destructive\". size: \"default\" | \"sm\"."
   },
   "ActionExpression": {
    "anyOf": [
     {
      "type": "object",
      "properties": {
       "type": {
        "type": "string",
        "const": "open_url"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "url"
      ],
      "additionalProperties": false
     },
     {
      "type": "object",
      "properties": {
       "type": {
        "type": "string",
        "const": "continue_conversation"
       },
       "context": {
        "type": "string"
       }
      },
      "required": [
       "type"
      ],
      "additionalProperties": false
     },
     {
      "type": "object",
      "properties": {
       "type": {
        "type": "string"
       },
       "params": {
        "type": "object",
        "propertyNames": {
         "type": "string"
        },
        "additionalProperties": {}
       }
      },
      "required": [
       "type"
      ],
      "additionalProperties": false
     }
    ]
   },
   "Input": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string"
     },
     "placeholder": {
      "type": "string"
     },
     "value": {
      "type": "string"
     }
    },
    "required": [
     "name"
    ],
    "additionalProperties": false,
    "description": "Text input. Bind a $variable as value to read it in actions."
   },
   "Checkbox": {
    "type": "object",
    "properties": {
     "label": {
      "type": "string"
     },
     "checked": {
      "type": "boolean"
     },
     "action": {
      "$ref": "#/$defs/ActionExpression"
     }
    },
    "required": [
     "label"
    ],
    "additionalProperties": false,
    "description": "Checkbox row with a label. checked shows state; action runs on toggle."
   },
   "Badge": {
    "type": "object",
    "properties": {
     "text": {
      "type": "string"
     },
     "variant": {
      "type": "string",
      "enum": [
       "default",
       "secondary",
       "destructive",
       "outline",
       "ghost",
       "link"
      ]
     }
    },
    "required": [
     "text"
    ],
    "additionalProperties": false,
    "description": "Inline label/badge. variant: \"default\" | \"secondary\" | \"destructive\" | \"outline\" | \"ghost\" | \"link\"."
   },
   "Progress": {
    "type": "object",
    "properties": {
     "value": {
      "type": "number"
     },
     "label": {
      "type": "string"
     }
    },
    "required": [
     "value"
    ],
    "additionalProperties": false,
    "description": "Progress bar showing completion percentage (0-100). Optional label."
   },
   "Alert": {
    "type": "object",
    "properties": {
     "title": {
      "type": "string"
     },
     "description": {
      "type": "string"
     },
     "variant": {
      "type": "string",
      "enum": [
       "default",
       "destructive",
       "info",
       "success",
       "warning"
      ]
     }
    },
    "required": [
     "title",
     "description"
    ],
    "additionalProperties": false,
    "description": "Alert banner with icon, title, and description. variant: \"default\" | \"destructive\" | \"info\" | \"success\" | \"warning\"."
   },
   "Separator": {
    "type": "object",
    "properties": {
     "orientation": {
      "type": "string",
      "enum": [
       "horizontal",
       "vertical"
      ]
     }
    },
    "additionalProperties": false,
    "description": "Horizontal or vertical rule. orientation: \"horizontal\" | \"vertical\"."
   },
   "Table": {
    "type": "object",
    "properties": {
     "columns": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/Col"
      }
     },
     "rows": {
      "type": "array",
      "items": {
       "type": "array",
       "items": {}
      }
     }
    },
    "required": [
     "columns",
     "rows"
    ],
    "additionalProperties": false,
    "description": "Data table. columns: Col[] with header/type, rows: 2D array of values."
   },
   "Col": {
    "type": "object",
    "properties": {
     "header": {
      "type": "string"
     },
     "type": {
      "type": "string",
      "enum": [
       "string",
       "number",
       "boolean"
      ]
     }
    },
    "required": [
     "header"
    ],
    "additionalProperties": false,
    "description": "Column definition for Table — header label and optional type."
   },
   "Empty": {
    "type": "object",
    "properties": {
     "title": {
      "type": "string"
     },
     "hint": {
      "type": "string"
     }
    },
    "required": [
     "title"
    ],
    "additionalProperties": false,
    "description": "Empty state: title and optional hint. Use when a list has no rows."
   },
   "BarChart": {
    "type": "object",
    "properties": {
     "labels": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "series": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/Series"
      }
     }
    },
    "required": [
     "labels",
     "series"
    ],
    "additionalProperties": false,
    "description": "Vertical bar chart for comparing values across categories."
   },
   "Series": {
    "type": "object",
    "properties": {
     "category": {
      "type": "string"
     },
     "values": {
      "type": "array",
      "items": {
       "type": "number"
      }
     }
    },
    "required": [
     "category",
     "values"
    ],
    "additionalProperties": false,
    "description": "One named data series with values matching labels."
   },
   "LineChart": {
    "type": "object",
    "properties": {
     "labels": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "series": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/Series"
      }
     }
    },
    "required": [
     "labels",
     "series"
    ],
    "additionalProperties": false,
    "description": "Line chart for trends over categories."
   },
   "Row": {
    "type": "object",
    "properties": {
     "children": {
      "type": "array",
      "items": {
       "anyOf": [
        {
         "$ref": "#/$defs/CardHeader"
        },
        {
         "$ref": "#/$defs/TextContent"
        },
        {
         "$ref": "#/$defs/Stat"
        },
        {
         "$ref": "#/$defs/Button"
        },
        {
         "$ref": "#/$defs/Input"
        },
        {
         "$ref": "#/$defs/Checkbox"
        },
        {
         "$ref": "#/$defs/Badge"
        },
        {
         "$ref": "#/$defs/Progress"
        },
        {
         "$ref": "#/$defs/Alert"
        },
        {
         "$ref": "#/$defs/Separator"
        },
        {
         "$ref": "#/$defs/Table"
        },
        {
         "$ref": "#/$defs/Empty"
        },
        {
         "$ref": "#/$defs/BarChart"
        },
        {
         "$ref": "#/$defs/LineChart"
        }
       ]
      }
     }
    },
    "required": [
     "children"
    ],
    "additionalProperties": false,
    "description": "Horizontal group. Children sit side by side and wrap when narrow."
   },
   "List": {
    "type": "object",
    "properties": {
     "children": {
      "type": "array",
      "items": {
       "anyOf": [
        {
         "$ref": "#/$defs/CardHeader"
        },
        {
         "$ref": "#/$defs/TextContent"
        },
        {
         "$ref": "#/$defs/Stat"
        },
        {
         "$ref": "#/$defs/Button"
        },
        {
         "$ref": "#/$defs/Input"
        },
        {
         "$ref": "#/$defs/Checkbox"
        },
        {
         "$ref": "#/$defs/Badge"
        },
        {
         "$ref": "#/$defs/Progress"
        },
        {
         "$ref": "#/$defs/Alert"
        },
        {
         "$ref": "#/$defs/Separator"
        },
        {
         "$ref": "#/$defs/Table"
        },
        {
         "$ref": "#/$defs/Empty"
        },
        {
         "$ref": "#/$defs/BarChart"
        },
        {
         "$ref": "#/$defs/LineChart"
        },
        {
         "$ref": "#/$defs/Row"
        }
       ]
      }
     }
    },
    "required": [
     "children"
    ],
    "additionalProperties": false,
    "description": "Vertical list of rows, for example @Each output. Separates rows with a hairline."
   }
  }
 }
}