{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/head-node-reminder.sh",
            "timeout": 10,
            "statusMessage": "Checking the head node"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/head-node-reminder.sh",
            "timeout": 10,
            "statusMessage": "Checking the head node"
          }
        ]
      }
    ]
  }
}
